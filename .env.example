# Copy to .env (gitignored). Never commit real values.

# Server
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres (docker-compose)
DATABASE_URL=postgres://veritas:veritas_password@localhost:5433/veritas

# Redis
REDIS_URL=redis://localhost:6379

# Blob store (RustFS, S3 API)
BLOB_ENDPOINT=http://localhost:9000
BLOB_BUCKET=veritas
BLOB_ACCESS_KEY=veritas
BLOB_SECRET_KEY=veritas_blob_secret

# Auth (Better Auth)
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser key for Google Picker / public Drive APIs
GOOGLE_API_KEY=

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
# Real relay, e.g. smtp.gmail.com:465 with a Google app password
SMTP_USER=
SMTP_PASS=
# Reserved test domains (example.test) always go to the local catcher
MAIL_CATCHER_HOST=localhost
MAIL_CATCHER_PORT=1025
MAIL_FROM="Veritas <no-reply@veritas.local>"

# AI
GEMINI_API_KEY=
# Ordered preference used to pick the default model from models.list
MODEL_PREFERENCE=pro,flash

# Connectors
CONNECTOR_KEK=generate-with-openssl-rand-base64-32
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
