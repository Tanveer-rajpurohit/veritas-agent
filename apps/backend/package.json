{
  "name": "@veritas/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python -m uvicorn app.main:app --reload --port 8000",
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "lint": "python -m ruff check --no-cache .",
    "format": "python -m ruff format --no-cache .",
    "format:check": "python -m ruff format --check --no-cache .",
    "test": "python -m pytest"
  }
}
