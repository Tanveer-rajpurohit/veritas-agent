APP_NAME=Veritas API
APP_VERSION=0.1.0
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3001"]
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=veritas_session
ACCESS_COOKIE_NAME=veritas_access
SESSION_COOKIE_SECURE=false
# Database & Vector Store
POSTGRES_DB=veritas
POSTGRES_USER=veritas
POSTGRES_PASSWORD=veritas_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://veritas:veritas_password@localhost:5433/veritas
REDIS_URL=redis://localhost:6379/0

# Object storage: keep both provider settings and select one backend.
# Local: OBJECT_STORAGE_BACKEND=minio. AWS: OBJECT_STORAGE_BACKEND=s3.
OBJECT_STORAGE_BACKEND=minio
BUCKET_NAME=veritas
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=veritas
MINIO_SECRET_KEY=replace-with-minio-password


# OCR
OCR_PROVIDER=local
AWS_REGION=ap-south-1
# Used by S3 and Bedrock when configured. Leave blank when using an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_AGENT_ENABLED=false

# LLM & Embeddings
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0.1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Retrieval Limits
WRITER_RETRIEVAL_LIMIT=8
WRITER_MAX_EVIDENCE_TOKENS=6000

# Legal Knowledge Sources (Statutes & Judgments)
# Statutes use the keyless eCourtsIndia adapter. Full case text uses Indian Kanoon.
LEGAL_STATUTE_PROVIDER=ecourts_india
LEGAL_CASE_PROVIDER=indian_kanoon
ECOURTS_INDIA_BASE_URL=https://indiacode.ecourtsindia.com/api/v1

# Indian Kanoon (Optional, for comprehensive Supreme Court & High Court case law)
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# Legal Source Network Safeguards
LEGAL_SOURCE_TIMEOUT_SECONDS=10.0
LEGAL_SOURCE_MAX_RESPONSE_BYTES=2000000
LEGAL_SOURCE_CACHE_TTL_SECONDS=86400

# MCA Company Master Data through data.gov.in
DATA_GOV_IN_BASE_URL=https://api.data.gov.in
DATA_GOV_IN_API_KEY=your_generated_key
MCA_COMPANY_MASTER_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a

# SMTP
SMTP_HOST=smtp.gmail.com                                                                       
SMTP_PORT=587                                                                                  
SMTP_USERNAME=example@gmail.com                                                            
SMTP_PASSWORD=                                                       
SMTP_FROM_EMAIL=example@gmail.com
